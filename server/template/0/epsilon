FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// ************************************************************************* //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform {{epsilonInlet}};

boundaryField
{
    inlet
    {
        type            atmBoundaryLayerInletEpsilon;
        z0              uniform {{terrainZ0}};
        d               uniform 0;
        flowDir         ({{windDirX}} {{windDirY}} {{windDirZ}});
        zDir            (0 0 1);
        kappa           0.41;
        Cmu             0.09;
        Uref            {{Uref}};
        Zref            {{Zref}};
        zGround         uniform {{zGround}};
        value           uniform {{epsilonInlet}};
    }
    outlet
    {
        type            zeroGradient;
    }
    sides
    {
        type            symmetry;
    }
    top
    {
        type            symmetry;
    }
    ground
    {
        type            atmEpsilonWallFunction;
        z0              uniform {{terrainZ0}};
        value           uniform {{epsilonInlet}};
    }
    structure
    {
        type            epsilonWallFunction;
        value           uniform {{epsilonInlet}};
    }
    terrain
    {
        type            atmEpsilonWallFunction;
        z0              uniform {{terrainZ0}};
        value           uniform {{epsilonInlet}};
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

// ************************************************************************* //

